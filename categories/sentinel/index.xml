srcset="https://robertodandrea.com/post/microsoft/migration-from-mma-to-ama-and-dcr-configuration--azure-policy/BuiltinPolicy_hu_a3fd7b8ef48d5c38.png 480w, https://robertodandrea.com/post/microsoft/migration-from-mma-to-ama-and-dcr-configuration--azure-policy/BuiltinPolicy_hu_b338c293c6621147.png 1024w"
loading="lazy"
