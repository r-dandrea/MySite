width="1788"
height="545"
srcset="https://robertodandrea.com/post/microsoft/migration-from-mma-to-ama-and-dcr-configuration--azure-policy/Policy_hu_258f3a9de6ad301.png 480w, https://robertodandrea.com/post/microsoft/migration-from-mma-to-ama-and-dcr-configuration--azure-policy/Policy_hu_ee3ea6d054790cc4.png 1024w"
loading="lazy"
alt="Policy"
class="gallery-image"
data-flex-grow="328"
data-flex-basis="787px"
&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;&lt;strong&gt;Policy for Installing the Azure Monitor Agent (AMA)&lt;/strong&gt;
&lt;img src="https://robertodandrea.com/post/microsoft/migration-from-mma-to-ama-and-dcr-configuration--azure-policy/AMAPolicy.png"
width="1755"
height="536"
srcset="https://robertodandrea.com/post/microsoft/migration-from-mma-to-ama-and-dcr-configuration--azure-policy/AMAPolicy_hu_4146a0c91c049fcb.png 480w, https://robertodandrea.com/post/microsoft/migration-from-mma-to-ama-and-dcr-configuration--azure-policy/AMAPolicy_hu_96b1db305a50f763.png 1024w"
loading="lazy"
alt="AMA Policy"
class="gallery-image"
data-flex-grow="327"
